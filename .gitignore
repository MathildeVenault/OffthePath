# .gitignore for OffthePath Visual Studio Project

# Build outputs
bin/
obj/
*.exe
*.dll
*.pdb
*.ilk
*.obj
*.exp
*.lib

# Visual Studio user-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/

# Visual C++ cache files
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Backup files
*~
*.bak
*.tmp

# OS files
Thumbs.db
.DS_Store
desktop.ini

# Compiled test payload (keep source)
payload/xmllite.dll

# Logs
*.log
